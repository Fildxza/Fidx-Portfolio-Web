# Copy this file to .env.local and fill in the values.
# The site builds and runs fine with these left blank — it falls back to the
# resume-derived content in src/lib/resume-data.ts until Supabase is connected.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- GitHub (Projects + GitHub Activity sections) ---
NEXT_PUBLIC_GITHUB_USERNAME=Fildxza
# Optional but recommended: a classic Personal Access Token with public_repo
# scope. Without it, pinned repos can't be fetched (GitHub's GraphQL API
# always requires auth) and you're limited to 60 unauthenticated requests/hour.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
